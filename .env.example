# Supabase-only database policy. The retained Prisma Dev directory is an
# offline archive; its ports are listed only so the freeze check can prove that
# no old daemon is listening. Supported commands never start or query it.
PAPERPILOT_PRISMA_DEV_ROOT=""
PAPERPILOT_PRISMA_DEV_PORT="51213"
PAPERPILOT_PRISMA_DEV_DB_PORT="51218"
PAPERPILOT_PRISMA_DEV_SHADOW_DB_PORT="51219"
PAPERPILOT_ALLOW_LOCAL_PRISMA_DEV="0"
## Vercel runtime: use the exact dashboard-issued Supavisor transaction-mode
## endpoint on port 6543. Copy the exact pooler hostname and project-scoped
## paperpilot_runtime URL from Supabase Connect; keep pgbouncer=true.
PAPERPILOT_DATABASE_PROFILE="supabase-avmcmmayvnjxrhrmgsdx-transaction-v1"
PAPERPILOT_SUPABASE_POOLER_HOST=""
# Optional PEM CA bundle. When empty, Node's verified system trust roots are
# used. If configured, it must be an absolute bounded CA-only PEM file.
PAPERPILOT_DATABASE_CA_CERT_PATH=""
DATABASE_URL=""
# Migration authority exists only in a protected setup/release environment.
# It must authenticate as paperpilot_migration_owner against the exact direct
# host on port 5432 and is never installed in a Vercel runtime environment.
PAPERPILOT_MIGRATION_DATABASE_PROFILE="supabase-avmcmmayvnjxrhrmgsdx-migration-v1"
PAPERPILOT_MIGRATION_DATABASE_URL=""
# One-time role bootstrap only. Remove both variables from the shell immediately
# after `npm run supabase:roles:bootstrap`; never install them in Vercel.
PAPERPILOT_BOOTSTRAP_DATABASE_PROFILE="supabase-avmcmmayvnjxrhrmgsdx-bootstrap-v1"
PAPERPILOT_BOOTSTRAP_DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Generate an independent high-entropy value for every deployment.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# Immutable release/image identity returned only as a readiness decision, never
# in the public payload. Optional locally; required and non-placeholder in
# production so operators can bind traffic admission to one deployed release.
PAPERPILOT_RELEASE_ID=""

# Optional independent key for domain-separated, non-reversible rate-limit
# bucket identifiers. If omitted, BETTER_AUTH_SECRET is used. Configure proxy
# values only from the deployment platform's documented forwarding topology.
PAPERPILOT_RATE_LIMIT_SECRET=""
PAPERPILOT_IP_ADDRESS_HEADERS=""
PAPERPILOT_TRUSTED_PROXIES=""
PAPERPILOT_IPV6_RATE_LIMIT_SUBNET=""

# Reader continuations are HMAC-signed and bound to user/workspace/paper. An
# empty value falls back to BETTER_AUTH_SECRET; production should use one
# independent 32-byte-or-longer value shared by every web node. Reader reads
# consume all applicable user/workspace/trusted-IP token buckets atomically.
PAPERPILOT_READER_CURSOR_SECRET=""
PAPERPILOT_READER_PDFJS="0"
PAPERPILOT_READER_USER_PER_MINUTE="60"
PAPERPILOT_READER_WORKSPACE_PER_MINUTE="300"
PAPERPILOT_READER_IP_PER_MINUTE="600"

# Zotero OAuth 1.0a. Register the exact callback URL in Zotero. OAuth requires
# an HTTPS application origin, including during local testing (use an HTTPS
# development origin/tunnel and establish the login session on that origin).
ZOTERO_OAUTH_CONSUMER_KEY=""
ZOTERO_OAUTH_CONSUMER_SECRET=""
ZOTERO_OAUTH_STATE_SECRET=""
ZOTERO_OAUTH_CALLBACK_URL="https://paperpilot.example/api/integrations/zotero/oauth/callback"

# Server-only, rotation-capable AES-256-GCM credential protection. Each value
# is an independent 32-byte random secret encoded as base64/base64url. The JSON
# object may retain older versions while ciphertext is being rotated.
PAPERPILOT_CREDENTIAL_ACTIVE_KEY_VERSION="v1"
PAPERPILOT_CREDENTIAL_ENCRYPTION_KEYS='{"v1":""}'
PAPERPILOT_CREDENTIAL_FINGERPRINT_KEY=""

# Cheap pre-session flood boundary for the public OAuth callback. Trusted
# proxy/IP resolution uses the same server configuration as other rate limits.
PAPERPILOT_ZOTERO_CALLBACK_IP_PER_MINUTE="120"

# The attachment worker is separate from metadata sync. It refuses to start
# without an explicit HTTPS blob-host allowlist. Exact origins are appropriate
# for dedicated hosts; shared path-style S3 hosts must also name one bucket.
# Example shapes (do not copy placeholder hosts into production):
# [{"kind":"exact-origin","origin":"https://dedicated-blob.example"}]
# [{"kind":"s3-path-style","origin":"https://s3.example","bucket":"approved-bucket"}]
PAPERPILOT_ZOTERO_ATTACHMENT_BLOB_ALLOWLIST=""
# PAPERPILOT_ZOTERO_ATTACHMENT_WORKER_ID="zotero-attachment-worker-1"

# Optional provider-neutral transactional delivery webhook. Configure all
# three values to enable production signup, verification, and password reset.
# The endpoint must be HTTPS and return 2xx without redirecting. The secret is
# sent only in an Authorization: Bearer header.
PAPERPILOT_EMAIL_WEBHOOK_URL=""
PAPERPILOT_EMAIL_WEBHOOK_SECRET=""
PAPERPILOT_EMAIL_FROM=""

# Production signup fails closed when the delivery values above are absent.
# Local evaluation remains available without email delivery.

# Local build/development only. Omit this in production, where BETTER_AUTH_URL
# must be an HTTPS origin.
PAPERPILOT_ALLOW_INSECURE_ORIGIN="true"

# Server-only OpenAlex credential. Never expose this as a NEXT_PUBLIC variable.
OPENALEX_API_KEY=""

# Local-development escape hatch. Production should use an API key.
OPENALEX_ALLOW_ANONYMOUS="false"

# The current serverless release permits exactly one connection per warm
# Function instance. Wider or malformed values fail closed.
DATABASE_POOL_MAX="1"

# Serverless private object plane. The secret key is Vercel/server-only
# and is used only to mint narrow capabilities; never pass it to Workflow state,
# a browser, or a Sandbox. The bucket remains private.
PAPERPILOT_SUPABASE_PROJECT_REF="avmcmmayvnjxrhrmgsdx"
PAPERPILOT_SUPABASE_URL="https://avmcmmayvnjxrhrmgsdx.supabase.co"
PAPERPILOT_SUPABASE_STORAGE_BUCKET="paperpilot-private-pdfs"
PAPERPILOT_SUPABASE_SECRET_KEY=""

# Required digest-pinned Vercel Sandbox image and bounded job envelope.
PAPERPILOT_PDF_SANDBOX_IMAGE=""
PAPERPILOT_PDF_SANDBOX_TIMEOUT_MS="900000"
PAPERPILOT_PDF_SANDBOX_VCPUS="2"

# Legacy/local adapter only. Never configure this in Vercel Production or use
# it as a fallback. Local development defaults to .paperpilot-data/quarantine.
# PAPERPILOT_UPLOAD_QUARANTINE_ROOT="E:/absolute/private/paperpilot-quarantine"
PAPERPILOT_UPLOAD_MAX_BYTES="26214400"
PAPERPILOT_UPLOAD_SESSION_TTL_SECONDS="900"
PAPERPILOT_UPLOAD_LEASE_TTL_SECONDS="600"
PAPERPILOT_UPLOAD_STREAM_IDLE_TIMEOUT_SECONDS="30"
PAPERPILOT_UPLOAD_STREAM_ABSOLUTE_TIMEOUT_SECONDS="300"
PAPERPILOT_UPLOAD_MAX_CONCURRENT_PER_USER="2"
PAPERPILOT_UPLOAD_MAX_CONCURRENT_PER_WORKSPACE="10"
PAPERPILOT_UPLOAD_MAX_RETAINED_BYTES_PER_WORKSPACE="262144000"

# Governed crawler first mode. Every request is an authenticated, affirmative
# command for one query-free HTTPS PDF and freezes these policy values into its
# durable authority row. Production requires explicit policy/rate/worker tokens.
# The exact-path first mode is deliberately redirect-free. A future redirect
# mode requires a separate reviewed destination-scope contract.
PAPERPILOT_CRAWLER_POLICY_VERSION="paperpilot-crawler-explicit-pdf-v1"
PAPERPILOT_CRAWLER_RATE_POLICY_VERSION="paperpilot-crawler-origin-rate-v1"
PAPERPILOT_CRAWLER_ROBOTS_USER_AGENT="PaperPilotCrawler"
PAPERPILOT_CRAWLER_WORKER_IDENTITY="paperpilot-crawler-local"
# Optional stable process identity; omit to derive a bounded process/UUID claim.
# PAPERPILOT_CRAWLER_WORKER_ID="crawler-worker-1"
# Must exceed both crawler and quarantine-stream absolute deadlines.
PAPERPILOT_CRAWLER_JOB_LEASE_TTL_MS="600000"
PAPERPILOT_CRAWLER_MAX_REDIRECTS="0"
PAPERPILOT_CRAWLER_MAX_DNS_ADDRESSES="8"
PAPERPILOT_CRAWLER_DNS_LOOKUP_TIMEOUT_MS="3000"
PAPERPILOT_CRAWLER_MAX_RESPONSE_BYTES="26214400"
PAPERPILOT_CRAWLER_MAX_RESPONSE_HEADER_BYTES="32768"
PAPERPILOT_CRAWLER_RESPONSE_HEADER_TIMEOUT_MS="5000"
PAPERPILOT_CRAWLER_RESPONSE_IDLE_TIMEOUT_MS="10000"
PAPERPILOT_CRAWLER_ABSOLUTE_DEADLINE_MS="60000"
PAPERPILOT_CRAWLER_ORIGIN_REQUESTS_PER_MINUTE="6"
PAPERPILOT_CRAWLER_ORIGIN_BURST="1"

# Isolated malware/PDF validation service. The web process only queues work;
# this configuration is loaded by `npm run worker:validation` before it claims
# a job. Production endpoints must be HTTPS. The secret must be an independent
# visible-ASCII value of at least 32 characters. Loopback HTTP is development-
# only. Keep the policy identifier aligned with the deployed validator image.
PAPERPILOT_VALIDATION_SERVICE_ENDPOINT="http://127.0.0.1:4010/v1/validate-pdf"
PAPERPILOT_VALIDATION_SERVICE_READINESS_ENDPOINT="http://127.0.0.1:4010/readyz"
PAPERPILOT_VALIDATION_SERVICE_BEARER_SECRET=""
PAPERPILOT_VALIDATION_POLICY_VERSION="paperpilot-document-validation-v1"
PAPERPILOT_VALIDATION_TIMEOUT_SECONDS="30"
PAPERPILOT_VALIDATION_MAX_RESPONSE_BYTES="16384"
PAPERPILOT_VALIDATION_SIGNATURE_MAX_AGE_SECONDS="86400"
PAPERPILOT_VALIDATION_FUTURE_CLOCK_SKEW_SECONDS="300"
# Optional. Omit to generate a bounded host/process/UUID identity.
# PAPERPILOT_VALIDATION_WORKER_ID="validator-worker-1"

# Separately deployed document-validator process. It can reuse the worker's
# bearer/policy variables above, but its endpoint must still be private and
# terminated with HTTPS in production. The digest is deployment provenance for
# the immutable image/SBOM + policy + scanner/parser binaries; never fabricate
# it from a placeholder. Keep the byte limit aligned with upload intake.
PAPERPILOT_VALIDATOR_HOST="127.0.0.1"
PAPERPILOT_VALIDATOR_PORT="4010"
PAPERPILOT_VALIDATOR_ROUTE="/v1/validate-pdf"
PAPERPILOT_VALIDATOR_TOOLCHAIN_DIGEST=""
PAPERPILOT_VALIDATOR_MAX_BODY_BYTES="26214400"
PAPERPILOT_VALIDATOR_BODY_IDLE_TIMEOUT_MS="3000"
PAPERPILOT_VALIDATOR_BODY_ABSOLUTE_TIMEOUT_MS="5000"
PAPERPILOT_VALIDATOR_VALIDATION_TIMEOUT_MS="20000"
PAPERPILOT_VALIDATOR_MAX_CONCURRENT="2"
PAPERPILOT_VALIDATOR_SIGNATURE_READINESS_MAX_AGE_MS="82800000"
PAPERPILOT_VALIDATOR_SIGNATURE_FUTURE_CLOCK_SKEW_MS="300000"
# PAPERPILOT_VALIDATOR_TEMP_ROOT="/private/ephemeral/paperpilot-validator"

# Isolated embedded-text extraction service. The extraction worker reads these
# values and validates service readiness before claiming a durable attempt.
# Production endpoints must be private HTTPS; loopback HTTP is development-only.
PAPERPILOT_EXTRACTION_SERVICE_ENDPOINT="http://127.0.0.1:4020/v1/extract-pdf"
PAPERPILOT_EXTRACTION_SERVICE_READINESS_ENDPOINT="http://127.0.0.1:4020/readyz"
PAPERPILOT_EXTRACTION_SERVICE_BEARER_SECRET=""
PAPERPILOT_EXTRACTION_POLICY_VERSION="paperpilot-text-extraction-v1"
# Independently pin the deployed extractor release provenance in both workers.
# It must equal the service response but must not be learned from that response.
PAPERPILOT_EXTRACTION_EXPECTED_TOOLCHAIN_DIGEST=""
PAPERPILOT_EXTRACTION_TIMEOUT_SECONDS="75"
PAPERPILOT_EXTRACTION_MAX_RESPONSE_BYTES="8388608"
PAPERPILOT_EXTRACTION_RESULT_MAX_AGE_SECONDS="900"
PAPERPILOT_EXTRACTION_FUTURE_CLOCK_SKEW_SECONDS="300"
# Optional. Omit to generate a bounded host/process/UUID identity.
# PAPERPILOT_EXTRACTION_WORKER_ID="extractor-worker-1"

# Separately deployed document-extractor process. It may reuse the worker's
# bearer/policy variables. Compute the digest from the immutable image/SBOM,
# policy, wrapper arguments, and exact Poppler binaries at deployment time.
PAPERPILOT_EXTRACTOR_HOST="127.0.0.1"
PAPERPILOT_EXTRACTOR_PORT="4020"
PAPERPILOT_EXTRACTOR_ROUTE="/v1/extract-pdf"
PAPERPILOT_EXTRACTOR_TOOLCHAIN_DIGEST=""
PAPERPILOT_EXTRACTOR_MAX_BODY_BYTES="26214400"
PAPERPILOT_EXTRACTOR_MAX_PAGES="2000"
PAPERPILOT_EXTRACTOR_MAX_TEXT_BYTES="4194304"
PAPERPILOT_EXTRACTOR_MAX_CHUNKS="4096"
PAPERPILOT_EXTRACTOR_MAX_CHUNK_BYTES="8192"
PAPERPILOT_EXTRACTOR_MAX_RESPONSE_BYTES="8388608"
PAPERPILOT_EXTRACTOR_BODY_IDLE_TIMEOUT_MS="3000"
PAPERPILOT_EXTRACTOR_BODY_ABSOLUTE_TIMEOUT_MS="5000"
PAPERPILOT_EXTRACTOR_EXTRACTION_TIMEOUT_MS="45000"
PAPERPILOT_EXTRACTOR_MAX_CONCURRENT="2"
# PAPERPILOT_EXTRACTOR_TEMP_ROOT="/private/ephemeral/paperpilot-extractor"
# Windows is unsupported in production. Tests/local-only development must opt in:
# PAPERPILOT_EXTRACTOR_ALLOW_INSECURE_WINDOWS_DEVELOPMENT="1"
