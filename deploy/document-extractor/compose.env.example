# Copy this file to `.env` beside compose.yaml. Never commit that copy.
# Generate a dedicated secret, for example with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
PAPERPILOT_EXTRACTOR_BEARER_SECRET=

PAPERPILOT_EXTRACTOR_POLICY_VERSION=paperpilot-text-extraction-v1

# Lowercase SHA-256 of the deployment's canonical provenance manifest. The
# manifest must bind the immutable extractor image, policy, Poppler arguments,
# and exact Poppler binaries/packages. Do not use zeroes or placeholder data.
PAPERPILOT_EXTRACTOR_TOOLCHAIN_DIGEST=

# These values are the reviewed reference snapshot. A production release must
# independently resolve, scan, approve, and record them rather than silently
# following a moving tag or Debian repository.
PAPERPILOT_EXTRACTOR_IMAGE=paperpilot/document-extractor:local
PAPERPILOT_EXTRACTOR_NODE_IMAGE=node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0
PAPERPILOT_EXTRACTOR_CA_CERTIFICATES_DEBIAN_VERSION=20250419
PAPERPILOT_EXTRACTOR_POPPLER_DEBIAN_VERSION=25.03.0-5+deb13u4
PAPERPILOT_EXTRACTOR_TINI_DEBIAN_VERSION=0.19.0-3+b7

PAPERPILOT_EXTRACTOR_BIND_ADDRESS=127.0.0.1
PAPERPILOT_EXTRACTOR_PUBLISHED_PORT=4020
