# Copy to deploy/app/.env on the Linux host, chmod 600, and fill every blank.
# Never commit the populated file. Generate independent application secrets as
# base64url values:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# Exact public origin: HTTPS, no path, query, fragment, credentials, or trailing
# slash. DNS A/AAAA records must resolve to this host before Caddy starts.
PAPERPILOT_PUBLIC_ORIGIN=https://paperpilot.example.com
PAPERPILOT_RELEASE_ID=

# Resolve, review, and pin these images by immutable registry digest. Do not
# substitute moving tags in a release .env.
PAPERPILOT_CADDY_IMAGE=
PAPERPILOT_APP_IMAGE=paperpilot/app:local
PAPERPILOT_VALIDATOR_IMAGE=paperpilot/document-validator:local
PAPERPILOT_EXTRACTOR_IMAGE=paperpilot/document-extractor:local

# Exact approved direct connection for Supabase project avmcmmayvnjxrhrmgsdx.
# Use only paperpilot_runtime, db.avmcmmayvnjxrhrmgsdx.supabase.co:5432,
# database postgres, and sslmode=verify-full. Percent-encode the database
# password in the URL. Never paste the populated URL into source, logs, shell
# history, screenshots, or support messages.
# Example shape only:
# postgresql://paperpilot_runtime:URL_ENCODED_PASSWORD@db.avmcmmayvnjxrhrmgsdx.supabase.co:5432/postgres?sslmode=verify-full
PAPERPILOT_SUPABASE_DATABASE_URL=

# Download the current database CA from the project's Supabase Connect/database
# SSL settings and store it as a regular file outside the repository. Compose
# mounts this one file read-only into web and both database-backed workers.
PAPERPILOT_SUPABASE_DATABASE_CA_CERT_HOST_PATH=
PAPERPILOT_DATABASE_POOL_MAX=5

# Independent application secrets; do not reuse any database or service secret.
PAPERPILOT_BETTER_AUTH_SECRET=
PAPERPILOT_RATE_LIMIT_SECRET=
PAPERPILOT_READER_CURSOR_SECRET=

# Configure all three together for production signup, verification, and
# password reset on a fresh database. The URL must be absolute HTTPS and the
# bearer secret must be independent. Leave all three blank only when the
# release already has an audited, verified demo identity.
PAPERPILOT_EMAIL_WEBHOOK_URL=
PAPERPILOT_EMAIL_WEBHOOK_SECRET=
PAPERPILOT_EMAIL_FROM=

# Caddy has a stable address on the internal app network so PaperPilot can trust
# exactly one forwarding proxy. If the CIDR changes, update all three together
# and verify it does not overlap a host/VPN network.
PAPERPILOT_APP_NETWORK_CIDR=172.30.241.0/24
PAPERPILOT_CADDY_APP_ADDRESS=172.30.241.2
PAPERPILOT_CADDY_TRUSTED_PROXY_CIDR=172.30.241.2/32
PAPERPILOT_IPV6_RATE_LIMIT_SUBNET=64

# Existing isolated validator/extractor contract. Each bearer is independent.
# Toolchain digests are lowercase, nonzero SHA-256 values computed from the
# reviewed immutable image/SBOM, policy, binaries, wrapper, and arguments; do
# not use a random digest merely to pass startup validation.
PAPERPILOT_VALIDATION_BEARER_SECRET=
PAPERPILOT_VALIDATION_POLICY_VERSION=paperpilot-document-validation-v1
PAPERPILOT_VALIDATOR_TOOLCHAIN_DIGEST=
PAPERPILOT_EXTRACTION_BEARER_SECRET=
PAPERPILOT_EXTRACTION_POLICY_VERSION=paperpilot-text-extraction-v1
PAPERPILOT_EXTRACTOR_TOOLCHAIN_DIGEST=
PAPERPILOT_VALIDATION_WORKER_ID=paperpilot-validation-1
PAPERPILOT_EXTRACTION_WORKER_ID=paperpilot-extraction-1

# Keep the public/file-service limits aligned. The release may choose a lower
# page ceiling but never one above the existing extractor authority.
PAPERPILOT_UPLOAD_MAX_BYTES=26214400
PAPERPILOT_UPLOAD_SESSION_TTL_SECONDS=900
PAPERPILOT_UPLOAD_LEASE_TTL_SECONDS=600
PAPERPILOT_UPLOAD_STREAM_IDLE_TIMEOUT_SECONDS=30
PAPERPILOT_UPLOAD_STREAM_ABSOLUTE_TIMEOUT_SECONDS=300
PAPERPILOT_UPLOAD_MAX_CONCURRENT_PER_USER=2
PAPERPILOT_UPLOAD_MAX_CONCURRENT_PER_WORKSPACE=10
PAPERPILOT_UPLOAD_MAX_RETAINED_BYTES_PER_WORKSPACE=262144000
PAPERPILOT_EXTRACTOR_MAX_PAGES=2000

# Gate-0 defaults fail closed. Enable a feature only when its implementation and
# focused proof are present; all approved core flags must be on for the Tuesday
# candidate. Inline image and local review may remain off.
PAPERPILOT_READER_PDFJS=0
PAPERPILOT_MENTOR_NATIVE_WEBMCP=0
PAPERPILOT_MENTOR_VISUAL_SOURCES=0
PAPERPILOT_MENTOR_CONNECT_IDEAS=0
PAPERPILOT_MENTOR_FOLLOWUPS=0
PAPERPILOT_MENTOR_LOCAL_REVIEW=0
PAPERPILOT_WEBMCP_INLINE_IMAGE_RESULT=0
