# Copy this file to `.env` beside compose.yaml. Never commit that copy.
# Generate a dedicated secret, for example with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
PAPERPILOT_VALIDATOR_BEARER_SECRET=

PAPERPILOT_VALIDATOR_POLICY_VERSION=paperpilot-document-validation-v1

# Lowercase SHA-256 of the deployment's canonical provenance manifest. The
# manifest must bind the immutable validator image, ClamAV image, policy and
# scanner/parser configuration. Do not use zeroes or placeholder data.
PAPERPILOT_VALIDATOR_TOOLCHAIN_DIGEST=

# These tag-plus-digest values are the reviewed multi-platform index snapshot
# for this reference. A production release must independently resolve, scan,
# approve, and record them rather than silently following a moving tag.
PAPERPILOT_VALIDATOR_IMAGE=paperpilot/document-validator:local
PAPERPILOT_VALIDATOR_NODE_IMAGE=node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0
PAPERPILOT_CLAMAV_IMAGE=clamav/clamav:1.5.4_base-debian13-slim@sha256:bbefacdc028635d83f4e6c81abf94db4f1d859b6f6009d90c94ae3d22625b235

PAPERPILOT_VALIDATOR_BIND_ADDRESS=127.0.0.1
PAPERPILOT_VALIDATOR_PUBLISHED_PORT=4010
