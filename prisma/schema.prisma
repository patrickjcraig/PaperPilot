generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core and organization-plugin models. Model and field names are
// intentionally left unmapped so the Prisma adapter can resolve them directly.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                  Session[]
  accounts                  Account[]
  memberships               Member[]
  invitationsSent           Invitation[]              @relation("InvitationInviter")
  teamMemberships           TeamMember[]
  workspacePapersAdded      WorkspacePaper[]          @relation("WorkspacePaperAddedBy")
  projectsCreated           Project[]                 @relation("ProjectCreatedBy")
  projectPapersAdded        ProjectPaper[]            @relation("ProjectPaperAddedBy")
  importBatchesRequested    ImportBatch[]             @relation("ImportBatchRequestedBy")
  inboxEntriesCreated       InboxEntry[]              @relation("InboxEntryCreatedBy")
  provenanceRecordsCreated  ProvenanceRecord[]        @relation("ProvenanceActor")
  evidenceNotesCreated      EvidenceNote[]            @relation("EvidenceNoteCreatedBy")
  collectionsCreated        Collection[]              @relation("CollectionCreatedBy")
  integrationsCreated       IntegrationConnection[]   @relation("IntegrationCreatedBy")
  jobsCreated               Job[]                     @relation("JobCreatedBy")
  auditEvents               AuditEvent[]              @relation("AuditActor")
  assetsCreated             Asset[]                   @relation("AssetCreatedBy")
  uploadSessionsCreated     UploadSession[]           @relation("UploadSessionCreatedBy")
  documentIntakesCreated    DocumentIntake[]          @relation("DocumentIntakeCreatedBy")
  ingestReceiptsRequested   DocumentIngestReceipt[]   @relation("DocumentIngestRequestedBy")
  zoteroPoliciesConfigured  ZoteroAttachmentPolicy[]  @relation("ZoteroAttachmentPolicyConfiguredBy")
  zoteroImportsRequested    ZoteroAttachmentImport[]  @relation("ZoteroAttachmentImportRequestedBy")
  crawlerImportsRequested   CrawlerImport[]           @relation("CrawlerImportRequestedBy")
  crawlerDeletionsRequested CrawlerImport[]           @relation("CrawlerImportDeletionRequestedBy")
  webMcpApprovals           WebMcpProposalApproval[]  @relation("WebMcpProposalApprovalActor")
  webMcpApprovalChallenges  WebMcpApprovalChallenge[] @relation("WebMcpApprovalChallengeActor")
  retainedAuditPrincipals   RetainedAuditPrincipal[]  @relation("RetainedAuditPrincipalLiveUser")
  idempotencyRecords        IdempotencyRecord[]       @relation("IdempotencyActor")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  activeTeamId         String?

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganizationSessions", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  activeTeam         Team?         @relation("ActiveTeamSessions", fields: [activeTeamId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([activeTeamId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@index([providerId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

// Better Auth 1.7.2's database-backed rate limiter addresses this model as
// `rateLimit`. `lastRequest` is an epoch-millisecond integer, not a DateTime.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
}

// Application request budgets are intentionally isolated from Better Auth's
// table because Better Auth prunes rows according to its own (shorter) auth
// windows. State is algorithm-specific and is mutated only while holding the
// PostgreSQL advisory lock derived from `key`.
model RateLimitBucket {
  key       String   @id @db.VarChar(191)
  policy    String   @db.VarChar(100)
  state     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?  @db.Text
  revision        Int      @default(0)
  kind            String   @default("PERSONAL")
  personalOwnerId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  activeSessions           Session[]                       @relation("ActiveOrganizationSessions")
  members                  Member[]
  invitations              Invitation[]
  teams                    Team[]
  roles                    OrganizationRole[]
  workspacePapers          WorkspacePaper[]
  projects                 Project[]
  projectPapers            ProjectPaper[]
  importBatches            ImportBatch[]
  inboxEntries             InboxEntry[]
  provenanceRecords        ProvenanceRecord[]
  evidenceNotes            EvidenceNote[]
  evidenceTextAnchors      EvidenceTextAnchor[]
  projectEvidenceNotes     ProjectEvidenceNote[]
  collections              Collection[]
  collectionPapers         CollectionPaper[]
  collectionEvidence       CollectionEvidenceNote[]
  integrations             IntegrationConnection[]
  zoteroLibraries          ZoteroLibrary[]
  zoteroObjects            ZoteroObject[]
  zoteroSyncRuns           ZoteroSyncRun[]
  zoteroSyncStages         ZoteroSyncStage[]
  jobs                     Job[]
  jobAttempts              JobAttempt[]
  auditEvents              AuditEvent[]
  documents                Document[]
  documentAssets           DocumentAsset[]
  documentTextChunks       DocumentTextChunk[]
  assets                   Asset[]
  uploadSessions           UploadSession[]
  uploadAttempts           UploadAttempt[]
  documentIntakes          DocumentIntake[]
  documentIngressAttempts  DocumentIngressAttempt[]
  documentIngestReceipts   DocumentIngestReceipt[]
  zoteroAttachments        ZoteroAttachment[]
  zoteroAttachmentPolicies ZoteroAttachmentPolicy[]
  zoteroAttachmentImports  ZoteroAttachmentImport[]
  crawlerImports           CrawlerImport[]
  validationAttestations   DocumentValidationAttestation[]
  textExtractions          DocumentTextExtraction[]
  webMcpApprovals          WebMcpProposalApproval[]
  webMcpApprovalChallenges WebMcpApprovalChallenge[]
  retainedAuditPrincipals  RetainedAuditPrincipal[]
  idempotencyRecords       IdempotencyRecord[]
}

// Stable, tenant-scoped authority identity. It deliberately stores no human
// profile data: account erasure severs liveUserId while retained authority rows
// continue to reference the random principal ID.
model RetainedAuditPrincipal {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String
  liveUserId      String?
  createdAt       DateTime  @default(now())
  pseudonymizedAt DateTime?

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  liveUser           User?                    @relation("RetainedAuditPrincipalLiveUser", fields: [liveUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  webMcpInboxEntries InboxEntry[]             @relation("InboxEntryRetainedCreator")
  provenanceRecords  ProvenanceRecord[]       @relation("ProvenanceRetainedActor")
  webMcpApprovals    WebMcpProposalApproval[] @relation("WebMcpApprovalRetainedActor")
  auditEvents        AuditEvent[]             @relation("AuditRetainedActor")
  crawlerImports     CrawlerImport[]          @relation("CrawlerImportRetainedRequester")
  crawlerDeletions   CrawlerImport[]          @relation("CrawlerImportRetainedDeletionRequester")

  @@unique([organizationId, id])
  @@unique([organizationId, liveUserId])
  @@index([liveUserId])
}

// Durable replay protection for every externally visible workspace command.
// The application stores only a hash of the normalized request payload.
model IdempotencyRecord {
  id             String    @id @default(cuid())
  organizationId String
  actorUserId    String?
  key            String
  command        String
  requestHash    String
  response       Json?
  status         String    @default("IN_PROGRESS")
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("IdempotencyActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([organizationId, command, createdAt])
  @@index([actorUserId])
  @@index([expiresAt])
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  zoteroOAuthAttempts ZoteroOAuthAttempt[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  teamId         String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId])
  @@index([organizationId, email, status])
  @@index([email])
  @@index([inviterId])
  @@index([teamId])
  @@index([status, expiresAt])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  memberCount    Int      @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  invitations    Invitation[]
  activeSessions Session[]    @relation("ActiveTeamSessions")

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model TeamMember {
  id            String   @id @default(cuid())
  teamId        String
  userId        String
  membershipKey String?  @unique
  createdAt     DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String
  role           String
  permission     String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@index([role])
}

enum PaperIdentifierType {
  DOI
  OPENALEX
  PMID
  PMCID
  ARXIV
  SEMANTIC_SCHOLAR
  MAG
  ISBN
  ISSN
  URL
  OTHER
}

enum PaperSource {
  OPENALEX
  CROSSREF
  PUBMED
  ARXIV
  SEMANTIC_SCHOLAR
  ZOTERO
  UPLOAD
  CRAWLER
  WEB_MCP
  MANUAL
  OTHER
}

enum WorkspacePaperStatus {
  INBOX
  SAVED
  READING
  READ
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectType {
  EVIDENCE_MAP
  LITERATURE_REVIEW
  SYSTEMATIC_REVIEW
}

enum ProjectVisibility {
  PRIVATE
  WORKSPACE
}

enum ImportSource {
  FILE_UPLOAD
  ZOTERO
  OPENALEX
  DOI_URL
  CRAWLER
  WEB_MCP
  MANUAL
  OTHER
}

enum ImportBatchStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum InboxEntryStatus {
  PENDING
  MATCHED
  IMPORTED
  DUPLICATE
  NEEDS_REVIEW
  REJECTED
  FAILED
}

enum WebMcpDuplicateDecision {
  CREATE_NEW
  USE_EXISTING
}

enum WebMcpVerificationAuthority {
  OPENALEX
  HUMAN_REVIEW
  EXISTING_CANONICAL
}

enum ProvenanceKind {
  DISCOVERY
  IMPORT
  METADATA
  EXTRACTION
  USER_ASSERTION
  ZOTERO_SYNC
  CRAWL
  WEB_MCP
  SYSTEM
}

