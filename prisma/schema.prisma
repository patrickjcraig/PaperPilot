  RECEIVING
  WRITTEN
  ADOPTED
  ABANDONED
  FAILED
}

enum DocumentKind {
  PAPER_PDF
  SUPPLEMENT
  HTML_SNAPSHOT
  DATASET
  NOTE
  EXPORT
  OTHER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssetStorageProvider {
  LOCAL
  S3
  CLOUDFLARE_R2
  GOOGLE_CLOUD_STORAGE
  AZURE_BLOB
  OTHER
}

enum AssetStatus {
  UPLOADING
  QUARANTINED
  SCANNING
  READY
  REJECTED
  DELETED
}

enum UploadSessionStatus {
  ISSUED
  RECEIVING
  STORED
  REJECTED
  EXPIRED
}

enum UploadAttemptStatus {
  RECEIVING
  WRITTEN
  COMMITTED
  FAILED
  ABANDONED
}

enum ValidationVerdict {
  ACCEPTED
  REJECTED
}

enum TextExtractionVerdict {
  EXTRACTED
  NO_TEXT
}

enum MalwareVerdict {
  CLEAN
  INFECTED
}

enum PdfStructuralVerdict {
  VALID
  INVALID
}

enum DocumentAssetRole {
  ORIGINAL
  NORMALIZED
  THUMBNAIL
  PREVIEW
  EXTRACTED_TEXT
  SUPPLEMENT
}

model Paper {
  id              String       @id @default(cuid())
  title           String       @db.Text
  abstractText    String?      @db.Text
  publicationYear Int?
  publicationDate DateTime?    @db.Date
  language        String?
  workType        String?
  venueName       String?
  citationCount   Int?
  isRetracted     Boolean      @default(false)
  primarySource   PaperSource?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  identifiers               PaperIdentifier[]
  authors                   PaperAuthor[]
  workspacePapers           WorkspacePaper[]
  provenanceRecords         ProvenanceRecord[]
  zoteroObjects             ZoteroObject[]
  documents                 Document[]
  webMcpApprovals           WebMcpProposalApproval[]  @relation("WebMcpProposalApprovalCanonicalPaper")
  webMcpSelections          WebMcpProposalApproval[]  @relation("WebMcpProposalApprovalSelectedPaper")
  webMcpChallengeSelections WebMcpApprovalChallenge[] @relation("WebMcpApprovalChallengeSelectedPaper")

  @@index([publicationYear])
  @@index([primarySource])
  @@index([isRetracted])
}

model PaperIdentifier {
  id              String              @id @default(cuid())
  paperId         String
  type            PaperIdentifierType
  value           String
  normalizedValue String
  source          PaperSource?
  createdAt       DateTime            @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue])
  @@unique([paperId, type, normalizedValue])
  @@index([paperId])
}

model PaperAuthor {
  id              String  @id @default(cuid())
  paperId         String
  position        Int
  displayName     String
  givenName       String?
  familyName      String?
  orcid           String?
  isCorresponding Boolean @default(false)

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, position])
  @@index([paperId])
  @@index([orcid])
}

model WorkspacePaper {
  id             String               @id @default(cuid())
  organizationId String
  paperId        String
  status         WorkspacePaperStatus @default(SAVED)
  priority       Int                  @default(0)
  isStarred      Boolean              @default(false)
  addedById      String?
  addedAt        DateTime             @default(now())
  lastOpenedAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Restrict)
  addedBy      User?        @relation("WorkspacePaperAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  projectPapers       ProjectPaper[]
  inboxEntries        InboxEntry[]
  provenanceRecords   ProvenanceRecord[]
  evidenceNotes       EvidenceNote[]
  evidenceTextAnchors EvidenceTextAnchor[]
  collectionPapers    CollectionPaper[]
  zoteroObjects       ZoteroObject[]
  documents           Document[]
  webMcpApprovals     WebMcpProposalApproval[]

  @@unique([organizationId, paperId])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([paperId])
  @@index([addedById])
}

model Project {
  id               String            @id @default(cuid())
  organizationId   String
  name             String
  slug             String
  description      String?           @db.Text
  researchQuestion String?           @db.Text
  type             ProjectType       @default(LITERATURE_REVIEW)
  visibility       ProjectVisibility @default(PRIVATE)
  status           ProjectStatus     @default(ACTIVE)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  papers                   ProjectPaper[]
  inboxEntries             InboxEntry[]
  evidenceNotes            EvidenceNote[]
  evidenceMemberships      ProjectEvidenceNote[]
  collections              Collection[]
  webMcpApprovals          WebMcpProposalApproval[]
  webMcpApprovalChallenges WebMcpApprovalChallenge[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([createdById])
}

model ProjectPaper {
  id               String   @id @default(cuid())
  organizationId   String
  projectId        String
  workspacePaperId String
  addedById        String?
  position         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  workspacePaper WorkspacePaper @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  addedBy        User?          @relation("ProjectPaperAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([projectId, workspacePaperId])
  @@unique([organizationId, projectId, workspacePaperId])
  @@index([organizationId, projectId])
  @@index([organizationId, workspacePaperId])
  @@index([addedById])
}

model ImportBatch {
  id                      String            @id @default(cuid())
  organizationId          String
  source                  ImportSource
  status                  ImportBatchStatus @default(QUEUED)
  label                   String?
  integrationConnectionId String?
  requestedById           String?
  externalRequestId       String?
  totalCount              Int               @default(0)
  processedCount          Int               @default(0)
  successCount            Int               @default(0)
  failureCount            Int               @default(0)
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration     IntegrationConnection?  @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  requestedBy     User?                   @relation("ImportBatchRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  entries         InboxEntry[]
  ingestReceipts  DocumentIngestReceipt[]
  documentIntakes DocumentIntake[]
  crawlerImport   CrawlerImport?

  @@unique([organizationId, externalRequestId])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([integrationConnectionId])
  @@index([requestedById])
}

model InboxEntry {
  id                   String           @id @default(cuid())
  organizationId       String
  importBatchId        String?
  projectId            String?
  workspacePaperId     String?
  documentId           String?
  source               ImportSource
  sourceKey            String?
  dedupeKey            String?
  status               InboxEntryStatus @default(PENDING)
  proposedTitle        String?          @db.Text
  proposedYear         Int?
  sourceUri            String?          @db.Text
  payload              Json?
  failureCode          String?
  failureMessage       String?          @db.Text
  createdById          String?
  createdByPrincipalId String?          @db.Uuid
  resolvedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch              ImportBatch?              @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  project                  Project?                  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  workspacePaper           WorkspacePaper?           @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document                 Document?                 @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy                User?                     @relation("InboxEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByPrincipal       RetainedAuditPrincipal?   @relation("InboxEntryRetainedCreator", fields: [organizationId, createdByPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "InboxEntry_retained_creator_fkey")
  provenanceRecords        ProvenanceRecord[]
  uploadSession            UploadSession?
  ingestReceipt            DocumentIngestReceipt?
  documentIntake           DocumentIntake?
  crawlerImport            CrawlerImport?
  webMcpApproval           WebMcpProposalApproval?
  webMcpApprovalChallenges WebMcpApprovalChallenge[]

  @@unique([organizationId, source, sourceKey])
  @@unique([organizationId, source, dedupeKey])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([importBatchId])
  @@index([projectId])
  @@index([workspacePaperId])
  @@index([documentId])
  @@index([createdById])
  @@index([createdByPrincipalId])
}

// A short-lived, one-use review capability. Provider I/O is complete before
// this row is inserted; final consent can therefore bind exactly the closed
// evidence shown to one actor and one complete approval intent.
model WebMcpApprovalChallenge {
  id                           String                      @id @db.VarChar(43)
  schemaVersion                Int
  organizationId               String
  actorUserId                  String
  inboxEntryId                 String
  proposalDigest               String                      @db.Char(64)
  destinationProjectId         String
  decision                     WebMcpDuplicateDecision
  selectedCanonicalPaperId     String?
  expectedOrganizationRevision Int
  verificationAuthority        WebMcpVerificationAuthority
  verificationAuthorityVersion String                      @db.VarChar(100)
  verificationEvidenceDigest   String                      @db.Char(64)
  verifiedSnapshot             Json
  createdAt                    DateTime                    @default(now())
  expiresAt                    DateTime
  consumedAt                   DateTime?

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor                  User                    @relation("WebMcpApprovalChallengeActor", fields: [actorUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inboxEntry             InboxEntry              @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  destinationProject     Project                 @relation(fields: [organizationId, destinationProjectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "WebMcpApprovalChallenge_organizationId_destinationProjectId_fke")
  selectedCanonicalPaper Paper?                  @relation("WebMcpApprovalChallengeSelectedPaper", fields: [selectedCanonicalPaperId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approval               WebMcpProposalApproval?

  @@unique([organizationId, id])
  @@index([organizationId, actorUserId, expiresAt], map: "WebMcpApprovalChallenge_organizationId_actorUserId_expiresAt_id")
  @@index([organizationId, inboxEntryId, expiresAt], map: "WebMcpApprovalChallenge_organizationId_inboxEntryId_expiresAt_i")
  @@index([destinationProjectId])
  @@index([selectedCanonicalPaperId])
  @@index([verificationEvidenceDigest])
}

// The exact human authority that promotes a metadata-only WebMCP proposal.
// Rows are immutable for their retained lifetime and database-guarded; a
// changed judgment requires a separately designed correction record. Explicit
// tenant-erasure transactions may delete the retained authority graph.
model WebMcpProposalApproval {
  id                           String                      @id @default(cuid())
  organizationId               String
  inboxEntryId                 String
  destinationProjectId         String
  approvedById                 String
  approvedByPrincipalId        String?                     @db.Uuid
  approvalCommandSchemaVersion Int
  challengeId                  String?                     @db.VarChar(43)
  proposalDigest               String                      @db.Char(64)
  decision                     WebMcpDuplicateDecision
  selectedCanonicalPaperId     String?
  canonicalPaperId             String
  workspacePaperId             String
  verificationAuthority        WebMcpVerificationAuthority
  verificationAuthorityVersion String                      @db.VarChar(100)
  verificationEvidenceDigest   String                      @db.Char(64)
  verifiedSnapshot             Json
  clientOperationId            String                      @db.VarChar(200)
  approvedAt                   DateTime                    @default(now())

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inboxEntry             InboxEntry               @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  destinationProject     Project                  @relation(fields: [organizationId, destinationProjectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  approvedBy             User                     @relation("WebMcpProposalApprovalActor", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedByPrincipal    RetainedAuditPrincipal?  @relation("WebMcpApprovalRetainedActor", fields: [organizationId, approvedByPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "WebMcpApproval_retained_actor_fkey")
  challenge              WebMcpApprovalChallenge? @relation(fields: [organizationId, challengeId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "WebMcpApproval_challenge_fkey")
  canonicalPaper         Paper                    @relation("WebMcpProposalApprovalCanonicalPaper", fields: [canonicalPaperId], references: [id], onDelete: Restrict)
  selectedCanonicalPaper Paper?                   @relation("WebMcpProposalApprovalSelectedPaper", fields: [selectedCanonicalPaperId], references: [id], onDelete: Restrict)
  workspacePaper         WorkspacePaper           @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, inboxEntryId])
  @@unique([organizationId, clientOperationId])
  @@unique([organizationId, id])
  @@unique([organizationId, challengeId])
  @@index([organizationId, approvedAt])
  @@index([destinationProjectId])
  @@index([approvedById])
  @@index([approvedByPrincipalId])
  @@index([canonicalPaperId])
  @@index([selectedCanonicalPaperId])
  @@index([workspacePaperId])
  @@index([proposalDigest])
}

// Application writers append corrections through supersedesId; there is no
// updatedAt field. Database triggers additionally make WebMCP staging and
// approval-bound IMPORT/METADATA authority lifetime-immutable. Other kinds
// still depend on restricted application-writer privileges for append-only use.
model ProvenanceRecord {
  id                      String         @id @default(cuid())
  organizationId          String
  kind                    ProvenanceKind
  paperId                 String?
  workspacePaperId        String?
  inboxEntryId            String?
  evidenceNoteId          String?
  documentId              String?
  zoteroObjectId          String?
  integrationConnectionId String?
  actorUserId             String?
  actorPrincipalId        String?        @db.Uuid
  supersedesId            String?
  sourceProvider          String?
  sourceRecordId          String?
  sourceUri               String?        @db.Text
  retrievedAt             DateTime?
  payloadDigest           String?
  payload                 Json?
  createdAt               DateTime       @default(now())

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paper          Paper?                  @relation(fields: [paperId], references: [id], onDelete: SetNull)
  workspacePaper WorkspacePaper?         @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  inboxEntry     InboxEntry?             @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  evidenceNote   EvidenceNote?           @relation(fields: [organizationId, evidenceNoteId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document       Document?               @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  zoteroObject   ZoteroObject?           @relation(fields: [organizationId, zoteroObjectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  integration    IntegrationConnection?  @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  actor          User?                   @relation("ProvenanceActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPrincipal RetainedAuditPrincipal? @relation("ProvenanceRetainedActor", fields: [organizationId, actorPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "ProvenanceRecord_retained_actor_fkey")
  supersedes     ProvenanceRecord?       @relation("ProvenanceCorrections", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  corrections    ProvenanceRecord[]      @relation("ProvenanceCorrections")

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([paperId])
  @@index([workspacePaperId])
  @@index([inboxEntryId])
  @@index([evidenceNoteId])
  @@index([documentId])
  @@index([zoteroObjectId])
  @@index([integrationConnectionId])
  @@index([actorUserId])
  @@index([actorPrincipalId])
  @@index([supersedesId])
  @@index([sourceProvider, sourceRecordId])
  @@index([payloadDigest])
}

model EvidenceNote {
  id                 String             @id @default(cuid())
  organizationId     String
  workspacePaperId   String
  projectId          String?
  documentId         String?
  documentChunkId    String?
  createdById        String?
  supersedesId       String?
  kind               EvidenceKind
  status             EvidenceStatus     @default(CAPTURED)
  confidence         EvidenceConfidence @default(UNSPECIFIED)
  title              String?
  claim              String?            @db.Text
  evidence           String?            @db.Text
  interpretation     String?            @db.Text
  openQuestion       String?            @db.Text
  linkedHighlightIds Json?
  tags               Json?
  quote              String?            @db.Text
  text               String             @db.Text
  pageStart          Int?
  pageEnd            Int?
  sectionId          String?
  sectionTitle       String?
  paragraphId        String?
  figureId           String?
  figureLabel        String?
  verifiedAt         DateTime?
  groundingVersion   Int?               @db.SmallInt
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspacePaper        WorkspacePaper           @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  project               Project?                 @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document              Document?                @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  documentChunk         DocumentTextChunk?       @relation(fields: [organizationId, documentChunkId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy             User?                    @relation("EvidenceNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  supersedes            EvidenceNote?            @relation("EvidenceNoteRevisions", fields: [organizationId, supersedesId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceNote_organizationId_supersedesId_fkey")
  revisions             EvidenceNote[]           @relation("EvidenceNoteRevisions")
  provenanceRecords     ProvenanceRecord[]
  projectMemberships    ProjectEvidenceNote[]
  collectionMemberships CollectionEvidenceNote[]
  textAnchor            EvidenceTextAnchor?

  @@unique([organizationId, id])
  @@unique([organizationId, workspacePaperId, id])
  @@unique([organizationId, supersedesId], map: "EvidenceNote_one_revision_per_note_key")
  @@index([organizationId, workspacePaperId])
  @@index([organizationId, projectId])
  @@index([documentId])
  @@index([documentChunkId])
  @@index([createdById])
  @@index([supersedesId])
  @@index([status])
}

// Immutable proof that a grounded evidence excerpt was derived by the server
// from one contiguous range in one database-admitted extraction manifest.
// Current/superseded state is projected by comparing extractionId with the
// document's current authority; the historical anchor itself never changes.
model EvidenceTextAnchor {
  id               String   @id @default(cuid())
  organizationId   String
  evidenceNoteId   String
  workspacePaperId String
  documentId       String
  extractionId     String
  schemaVersion    Int      @db.SmallInt
  manifestSha256   String   @db.Char(64)
  startChunkId     String
  endChunkId       String
  startSequence    Int
  endSequence      Int
  startByteOffset  Int
  endByteOffset    Int
  startContentHash String
  endContentHash   String
  quoteText        String   @db.Text
  quoteSha256      String   @db.Char(64)
  pageStart        Int
  pageEnd          Int
  paragraphStartId String   @db.VarChar(200)
  paragraphEndId   String   @db.VarChar(200)
  createdAt        DateTime @default(now())

  organization      Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "EvidenceTextAnchor_organizationId_fkey")
  evidenceNote      EvidenceNote                  @relation(fields: [organizationId, workspacePaperId, evidenceNoteId], references: [organizationId, workspacePaperId, id], onDelete: Cascade, onUpdate: NoAction, map: "EvidenceTextAnchor_note_fkey")
  workspacePaper    WorkspacePaper                @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceTextAnchor_workspace_paper_fkey")
  document          Document                      @relation(fields: [organizationId, workspacePaperId, documentId], references: [organizationId, workspacePaperId, id], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceTextAnchor_document_fkey")
  manifestAdmission DocumentTextManifestAdmission @relation(fields: [organizationId, documentId, extractionId, schemaVersion, manifestSha256], references: [organizationId, documentId, extractionId, schemaVersion, manifestSha256], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceTextAnchor_manifest_admission_fkey")
  startChunk        DocumentTextChunk             @relation("EvidenceTextAnchorStartChunk", fields: [organizationId, documentId, extractionId, startChunkId, startSequence, startContentHash], references: [organizationId, documentId, extractionId, id, sequence, contentHash], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceTextAnchor_start_chunk_fkey")
  endChunk          DocumentTextChunk             @relation("EvidenceTextAnchorEndChunk", fields: [organizationId, documentId, extractionId, endChunkId, endSequence, endContentHash], references: [organizationId, documentId, extractionId, id, sequence, contentHash], onDelete: NoAction, onUpdate: NoAction, map: "EvidenceTextAnchor_end_chunk_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, workspacePaperId, evidenceNoteId], map: "EvidenceTextAnchor_note_binding_key")
  @@index([organizationId, workspacePaperId, createdAt(sort: Desc)], map: "EvidenceTextAnchor_workspace_created_idx")
  @@index([organizationId, documentId, extractionId])
  @@index([organizationId, startChunkId])
  @@index([organizationId, endChunkId])
}

// A structured note may support more than one visible project that already
// contains its paper. The tenant key is repeated on both foreign keys so a
// malformed or compromised caller cannot create a cross-workspace edge.
model ProjectEvidenceNote {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  evidenceNoteId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  evidenceNote EvidenceNote @relation(fields: [organizationId, evidenceNoteId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, evidenceNoteId])
  @@unique([organizationId, projectId, evidenceNoteId])
  @@index([organizationId, projectId])
  @@index([organizationId, evidenceNoteId])
}

model Collection {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  parentId       String?
  name           String
  description    String?  @db.Text
  color          String?
  position       Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?                 @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  parent              Collection?              @relation("CollectionTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  children            Collection[]             @relation("CollectionTree")
  createdBy           User?                    @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  paperMemberships    CollectionPaper[]
  evidenceMemberships CollectionEvidenceNote[]
  zoteroObjects       ZoteroObject[]

  @@unique([organizationId, projectId, parentId, name])
  @@unique([organizationId, id])
  @@index([organizationId, projectId])
  @@index([parentId])
  @@index([createdById])
}

model CollectionPaper {
  id               String   @id @default(cuid())
  organizationId   String
  collectionId     String
  workspacePaperId String
  position         Int?
  createdAt        DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection     Collection     @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  workspacePaper WorkspacePaper @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([collectionId, workspacePaperId])
  @@index([organizationId, collectionId])
  @@index([organizationId, workspacePaperId])
}

model CollectionEvidenceNote {
  id             String   @id @default(cuid())
  organizationId String
  collectionId   String
  evidenceNoteId String
  position       Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  evidenceNote EvidenceNote @relation(fields: [organizationId, evidenceNoteId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([collectionId, evidenceNoteId])
  @@index([organizationId, collectionId])
  @@index([organizationId, evidenceNoteId])
}

model IntegrationConnection {
  id                          String              @id @default(cuid())
  organizationId              String
  provider                    IntegrationProvider
  authType                    IntegrationAuthType
  status                      IntegrationStatus   @default(PENDING)
  displayName                 String?
  externalAccountId           String?
  scopes                      Json?
  configuration               Json?
  credentialCiphertext        Bytes?
  credentialFingerprint       String?
  credentialKeyVersion        String?
  credentialExpiresAt         DateTime?
  lastVerifiedAt              DateTime?
  providerBackoffUntil        DateTime?
  credentialGeneration        Int                 @default(0)
  zoteroSelectionRevision     Int                 @default(0)
  zoteroLibrariesConfiguredAt DateTime?
  lastErrorCode               String?
  lastErrorMessage            String?             @db.Text
  createdById                 String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  revokedAt                   DateTime?

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("IntegrationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  importBatches     ImportBatch[]
  provenanceRecords ProvenanceRecord[]
  zoteroLibraries   ZoteroLibrary[]
  jobs              Job[]
  oauthAttempts     ZoteroOAuthAttempt[]
  ingestReceipts    DocumentIngestReceipt[]
  attachmentPolicy  ZoteroAttachmentPolicy?
  attachmentImports ZoteroAttachmentImport[]

  @@unique([organizationId, provider, externalAccountId])
  // PostgreSQL truncates the original generated identifier to 63 bytes; map
  // it explicitly so Prisma introspection and migration diff agree exactly.
  @@unique([organizationId, provider, credentialFingerprint], map: "IntegrationConnection_organizationId_provider_credentialFingerp")
  @@unique([organizationId, id])
  @@index([organizationId, provider, status])
  @@index([createdById])
}

// Temporary OAuth credentials are one-time, tenant-bound envelopes. State,
// nonce, and request-token values are retained only as keyed hashes; the
// temporary secret ciphertext is erased atomically when an attempt is claimed.
model ZoteroOAuthAttempt {
  id                           String                   @id @default(cuid())
  organizationId               String
  userId                       String
  status                       ZoteroOAuthAttemptStatus @default(PENDING)
  stateTokenHash               String                   @unique @db.Char(64)
  stateNonceHash               String                   @db.Char(64)
  requestTokenHash             String                   @db.Char(64)
  requestTokenSecretCiphertext Bytes?
  requestTokenSecretKeyVersion String?
  callbackUrlHash              String                   @db.Char(64)
  requestedScopes              Json
  expiresAt                    DateTime
  claimedAt                    DateTime?
  completedAt                  DateTime?
  failureCode                  String?
  integrationConnectionId      String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  membership Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction)
  connection IntegrationConnection? @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@unique([organizationId, stateNonceHash])
  @@unique([organizationId, requestTokenHash])
  @@index([organizationId, userId, status])
  @@index([status, expiresAt])
  @@index([integrationConnectionId])
}

model ZoteroLibrary {
  id                      String                 @id @default(cuid())
  organizationId          String
  integrationConnectionId String
  libraryType             ZoteroLibraryType
  zoteroLibraryId         String
  name                    String?
  isReadable              Boolean                @default(false)
  isWritable              Boolean                @default(false)
  fileAccessStatus        ZoteroFileAccessStatus @default(UNKNOWN)
  accessLostAt            DateTime?
  discoveredAt            DateTime               @default(now())
  lastDiscoveredAt        DateTime               @default(now())
  lastSyncedVersion       String?
  lastItemVersion         String?
  lastCollectionVersion   String?
  lastDeletionVersion     String?
  lastFulltextVersion     String?
  lastSyncedAt            DateTime?
  syncEnabled             Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration       IntegrationConnection    @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  objects           ZoteroObject[]
  syncRuns          ZoteroSyncRun[]
  syncStages        ZoteroSyncStage[]
  jobs              Job[]
  ingestReceipts    DocumentIngestReceipt[]
  attachments       ZoteroAttachment[]
  attachmentImports ZoteroAttachmentImport[]

  @@unique([integrationConnectionId, libraryType, zoteroLibraryId])
  @@unique([organizationId, id])
  @@unique([organizationId, integrationConnectionId, id], map: "ZoteroLibrary_connection_binding_key")
  @@index([organizationId, syncEnabled])
  @@index([integrationConnectionId])
}

model ZoteroObject {
  id               String           @id @default(cuid())
  organizationId   String
  zoteroLibraryId  String
  objectType       ZoteroObjectType
  zoteroKey        String
  parentKey        String?
  version          String
  paperId          String?
  workspacePaperId String?
  collectionId     String?
  documentId       String?
  isDeleted        Boolean          @default(false)
  contentHash      String?
  data             Json?
  zoteroModifiedAt DateTime?
  lastSyncedAt     DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  library           ZoteroLibrary           @relation(fields: [organizationId, zoteroLibraryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  paper             Paper?                  @relation(fields: [paperId], references: [id], onDelete: SetNull)
  workspacePaper    WorkspacePaper?         @relation(fields: [organizationId, workspacePaperId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  collection        Collection?             @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document          Document?               @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  provenanceRecords ProvenanceRecord[]
  ingestReceipts    DocumentIngestReceipt[]
  attachment        ZoteroAttachment?

  @@unique([zoteroLibraryId, objectType, zoteroKey])
  @@unique([organizationId, id])
  @@unique([organizationId, zoteroLibraryId, id], map: "ZoteroObject_library_binding_key")
  @@index([organizationId, objectType, isDeleted])
  @@index([zoteroLibraryId, version])
  @@index([paperId])
  @@index([workspacePaperId])
  @@index([collectionId])
  @@index([documentId])
  @@index([parentKey])
}

// Attachment ingestion is opt-in. Absence of this row is equivalent to
// DISABLED; changing the policy increments revision so queued work can prove
// which authorization decision it was created under.
model ZoteroAttachmentPolicy {
  id                      String                     @id @default(cuid())
  organizationId          String
  integrationConnectionId String                     @unique
  mode                    ZoteroAttachmentIngestMode @default(DISABLED)
  revision                Int                        @default(0)
  configuredById          String?
  configuredAt            DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration  IntegrationConnection @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  configuredBy User?                 @relation("ZoteroAttachmentPolicyConfiguredBy", fields: [configuredById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@unique([organizationId, integrationConnectionId], map: "ZoteroAttachmentPolicy_connection_binding_key")
  @@index([organizationId, mode])
  @@index([configuredById])
}

// A sanitized, metadata-only projection of a Zotero ITEM attachment. Provider
// paths and signed URLs are never stored here. Tombstoned provider objects are
// retained so completed imports keep an auditable source identity.
model ZoteroAttachment {
  zoteroObjectId  String                      @id
  organizationId  String
  zoteroLibraryId String
  parentKey       String?                     @db.VarChar(64)
  linkMode        String?                     @db.VarChar(32)
  contentType     String?                     @db.VarChar(255)
  fileName        String?                     @db.VarChar(255)
  providerMd5     String?                     @db.Char(32)
  providerMtime   String?                     @db.VarChar(32)
  sourceVersion   String                      @db.VarChar(128)
  metadataHash    String                      @db.Char(64)
  eligibility     ZoteroAttachmentEligibility
  reasonCode      String?                     @db.VarChar(100)
  isDeleted       Boolean                     @default(false)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  library      ZoteroLibrary            @relation(fields: [organizationId, zoteroLibraryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  object       ZoteroObject             @relation(fields: [organizationId, zoteroLibraryId, zoteroObjectId], references: [organizationId, zoteroLibraryId, id], onDelete: Restrict, onUpdate: NoAction)
  imports      ZoteroAttachmentImport[]

  @@unique([organizationId, zoteroLibraryId, zoteroObjectId], map: "ZoteroAttachment_library_object_binding_key")
  @@index([organizationId, eligibility, isDeleted])
  @@index([organizationId, zoteroLibraryId, parentKey])
  @@index([organizationId, providerMd5])
}

// One explicit user command to copy one immutable Zotero attachment version
// into PaperPilot custody. Secrets and signed provider URLs never enter this
// record or a job payload; workers resolve credentials by generation.
model ZoteroAttachmentImport {
  id                      String                       @id @default(cuid())
  organizationId          String
  integrationConnectionId String
  zoteroLibraryId         String
  zoteroObjectId          String
  intakeId                String                       @unique
  documentId              String
  assetId                 String
  requestedById           String?
  clientOperationId       String
  requestHash             String                       @db.Char(64)
  policyRevision          Int
  credentialGeneration    Int
  sourceVersion           String                       @db.VarChar(128)
  sourceMetadataHash      String                       @db.Char(64)
  providerMd5             String                       @db.Char(32)
  status                  ZoteroAttachmentImportStatus @default(QUEUED)
  downloadJobId           String?                      @unique
  failureCode             String?                      @db.VarChar(100)
  retryAt                 DateTime?
  startedAt               DateTime?
  quarantinedAt           DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   IntegrationConnection  @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "ZoteroAttachmentImport_connection_fkey")
  library       ZoteroLibrary          @relation(fields: [organizationId, integrationConnectionId, zoteroLibraryId], references: [organizationId, integrationConnectionId, id], onDelete: Restrict, onUpdate: NoAction, map: "ZoteroAttachmentImport_library_connection_fkey")
  attachment    ZoteroAttachment       @relation(fields: [organizationId, zoteroLibraryId, zoteroObjectId], references: [organizationId, zoteroLibraryId, zoteroObjectId], onDelete: Restrict, onUpdate: NoAction)
  intake        DocumentIntake         @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "ZoteroAttachmentImport_intake_target_fkey")
  requestedBy   User?                  @relation("ZoteroAttachmentImportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  downloadJob   Job?                   @relation(fields: [organizationId, integrationConnectionId, zoteroLibraryId, documentId, assetId, intakeId, downloadJobId], references: [organizationId, integrationConnectionId, zoteroLibraryId, documentId, assetId, intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "ZoteroAttachmentImport_download_job_target_fkey")
  ingestReceipt DocumentIngestReceipt?

  @@unique([organizationId, id])
  @@unique([organizationId, clientOperationId], map: "ZoteroAttachmentImport_idempotency_key")
  @@unique([organizationId, documentId, assetId, intakeId], map: "ZoteroAttachmentImport_intake_binding_key")
  @@unique([organizationId, integrationConnectionId, zoteroLibraryId, documentId, assetId, intakeId, downloadJobId], map: "ZoteroAttachmentImport_download_job_binding_key")
  @@unique([organizationId, integrationConnectionId, zoteroLibraryId, zoteroObjectId, documentId, assetId, intakeId, id], map: "ZoteroAttachmentImport_target_binding_key")
  // PostgreSQL additionally enforces one non-failed/non-cancelled import for
  // this exact source generation with a partial unique index. Prisma cannot
  // represent that predicate, so keep the lookup index visible here.
  @@index([organizationId, zoteroObjectId, sourceVersion, providerMd5], map: "ZoteroAttachmentImport_source_generation_idx")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, zoteroLibraryId, zoteroObjectId])
  @@index([organizationId, integrationConnectionId, credentialGeneration])
  @@index([requestedById])
  @@index([retryAt])
}

// One explicit user command to bring one canonical, query-free HTTPS source
// into governed PaperPilot custody. The job payload is never authority: this
// row freezes the exact URL, grant, policy/rate versions, byte ceiling, network
// bounds, requester, target graph, and crawl job that every retry must honor.
model CrawlerImport {
  id                                 String                         @id @default(cuid())
  organizationId                     String
  importBatchId                      String                         @unique
  intakeId                           String                         @unique
  documentId                         String
  assetId                            String
  inboxEntryId                       String                         @unique
  requestedById                      String?
  requestedByPrincipalId             String                         @db.Uuid
  clientOperationId                  String
  requestHash                        String                         @db.Char(64)
  // Redacted to NULL when user deletion is accepted. The domain-separated
  // fingerprint remains as minimal collision/audit evidence.
  canonicalSourceUrl                 String?                        @db.Text
  // Remote-URL authority only. Document/Inbox source identities use this
  // command's attempt-specific `crawler-import:<id>` key instead.
  sourceUrlFingerprint               String                         @db.Char(64)
  displayFileName                    String                         @db.VarChar(255)
  rightsGrant                        CrawlerRightsGrant
  rightsAttestationVersion           String                         @db.VarChar(100)
  rightsAttestedAt                   DateTime                       @db.Timestamptz(3)
  robotsPolicy                       CrawlerRobotsPolicy
  robotsPolicyVersion                String                         @db.VarChar(100)
  retentionPolicy                    CrawlerRetentionPolicy
  retentionPolicyVersion             String                         @db.VarChar(100)
  acquisitionMode                    String                         @db.VarChar(100)
  policyVersion                      String                         @db.VarChar(128)
  robotsUserAgent                    String                         @db.VarChar(64)
  maxRedirects                       Int
  maxDnsAddresses                    Int
  dnsLookupTimeoutMs                 Int
  maxResponseHeaderBytes             Int
  responseHeaderTimeoutMs            Int
  responseIdleTimeoutMs              Int
  absoluteDeadlineMs                 Int
  ratePolicyVersion                  String                         @db.VarChar(100)
  originRequestsPerMinute            Int
  originBurst                        Int
  maximumSizeBytes                   BigInt
  policyRevision                     Int
  status                             CrawlerImportStatus            @default(QUEUED)
  crawlJobId                         String                         @unique
  failureCode                        String?                        @db.VarChar(100)
  retryAt                            DateTime?                      @db.Timestamptz(3)
  startedAt                          DateTime?                      @db.Timestamptz(3)
  quarantinedAt                      DateTime?                      @db.Timestamptz(3)
  completedAt                        DateTime?                      @db.Timestamptz(3)
  cancelledAt                        DateTime?                      @db.Timestamptz(3)
  custodyStatus                      CrawlerCustodyStatus           @default(RETAINED)
  deletionRequestedById              String?
  deletionRequestedByPrincipalId     String?                        @db.Uuid
  deletionClientOperationId          String?                        @db.VarChar(200)
  deletionRequestHash                String?                        @db.Char(64)
  deletionRequestedAt                DateTime?                      @db.Timestamptz(3)
  deletionAfter                      DateTime?                      @db.Timestamptz(3)
  deletionLeaseId                    String?                        @db.VarChar(200)
  deletionLeaseExpiresAt             DateTime?                      @db.Timestamptz(3)
  deletionAttemptCount               Int                            @default(0)
  deletionFailureCode                String?                        @db.VarChar(100)
  deletionProofDigest                String?                        @db.Char(64)
  // Immutable canonical local-root authority selected at first crawler claim.
  // Legacy pre-authority rows remain NULL and can never receive a new proof.
  storageAuthorityGeneration         String?                        @db.Char(64)
  deletionStorageAuthorityGeneration String?                        @db.Char(64)
  deletionTombstoneDigest            String?                        @db.Char(64)
  derivedTextDisposition             CrawlerDerivedTextDisposition?
  derivedTextDisposedAt              DateTime?                      @db.Timestamptz(3)
  derivedTextPurgedChunkCount        Int?
  derivedTextRetainedChunkCount      Int?
  deletedAt                          DateTime?                      @db.Timestamptz(3)
  createdAt                          DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime                       @updatedAt @db.Timestamptz(3)

  organization                 Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatch                  ImportBatch             @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "CrawlerImport_import_batch_fkey")
  intake                       DocumentIntake          @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "CrawlerImport_intake_target_fkey")
  inboxEntry                   InboxEntry              @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  requestedBy                  User?                   @relation("CrawlerImportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  requestedByPrincipal         RetainedAuditPrincipal  @relation("CrawlerImportRetainedRequester", fields: [organizationId, requestedByPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "CrawlerImport_retained_requester_fkey")
  deletionRequestedBy          User?                   @relation("CrawlerImportDeletionRequestedBy", fields: [deletionRequestedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletionRequestedByPrincipal RetainedAuditPrincipal? @relation("CrawlerImportRetainedDeletionRequester", fields: [organizationId, deletionRequestedByPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "CrawlerImport_retained_deletion_requester_fkey")
  crawlJob                     Job                     @relation(fields: [organizationId, documentId, assetId, intakeId, crawlJobId], references: [organizationId, documentId, assetId, intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "CrawlerImport_crawl_job_target_fkey")
  ingestReceipt                DocumentIngestReceipt?

  @@unique([organizationId, id])
  @@unique([organizationId, clientOperationId], map: "CrawlerImport_idempotency_key")
  @@unique([organizationId, deletionClientOperationId], map: "CrawlerImport_deletion_idempotency_key")
  @@unique([organizationId, importBatchId], map: "CrawlerImport_import_batch_binding_key")
  @@unique([organizationId, documentId, assetId, intakeId], map: "CrawlerImport_intake_binding_key")
  @@unique([organizationId, inboxEntryId], map: "CrawlerImport_inbox_binding_key")
  @@unique([organizationId, documentId, assetId, intakeId, crawlJobId], map: "CrawlerImport_crawl_job_binding_key")
  @@unique([organizationId, documentId, assetId, intakeId, importBatchId, id], map: "CrawlerImport_target_binding_key")
  // PostgreSQL enforces the live source-fingerprint uniqueness predicate; the
  // non-unique lookup index remains visible to Prisma for command admission.
  @@index([organizationId, sourceUrlFingerprint], map: "CrawlerImport_source_fingerprint_idx")
  @@index([organizationId, status, createdAt])
  @@index([requestedById])
  @@index([requestedByPrincipalId])
  @@index([retryAt])
  @@index([custodyStatus, deletionAfter])
  @@index([deletionRequestedById])
  @@index([deletionRequestedByPrincipalId])
}

model ZoteroSyncRun {
  id              String        @id @default(cuid())
  organizationId  String
  zoteroLibraryId String
  direction       SyncDirection @default(PULL)
  status          SyncRunStatus @default(QUEUED)
  fromVersion     String?
  toVersion       String?
  requestId       String?
  objectsRead     Int           @default(0)
  objectsWritten  Int           @default(0)
  objectsDeleted  Int           @default(0)
  conflicts       Int           @default(0)
  backoffUntil    DateTime?
  errorCode       String?
  errorMessage    String?       @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  library      ZoteroLibrary     @relation(fields: [organizationId, zoteroLibraryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  stages       ZoteroSyncStage[]

  @@unique([zoteroLibraryId, requestId])
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([zoteroLibraryId, startedAt])
  @@index([backoffUntil])
}

// A sync pass writes only to this run-owned staging area while the provider
// library can still be changing. Rows become authoritative ZoteroObjects only
// after every provider response agrees on one Last-Modified-Version and the
// worker still owns its fenced lease.
model ZoteroSyncStage {
  id              String           @id @default(cuid())
  organizationId  String
  zoteroSyncRunId String
  zoteroLibraryId String
  objectType      ZoteroObjectType
  zoteroKey       String
  parentKey       String?
  version         String
  isDeleted       Boolean          @default(false)
  contentHash     String?
  data            Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          ZoteroSyncRun @relation(fields: [organizationId, zoteroSyncRunId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  library      ZoteroLibrary @relation(fields: [organizationId, zoteroLibraryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([zoteroSyncRunId, objectType, zoteroKey])
  @@unique([organizationId, id])
  @@index([organizationId, zoteroLibraryId])
  @@index([zoteroSyncRunId, isDeleted])
}

model Job {
  id                      String    @id @default(cuid())
  organizationId          String
  type                    JobType
  status                  JobStatus @default(QUEUED)
  dedupeKey               String?
  priority                Int       @default(0)
  payload                 Json?
  result                  Json?
  attempts                Int       @default(0)
  maxAttempts             Int       @default(5)
  runAfter                DateTime  @default(now())
  lockedAt                DateTime?
  lockedBy                String?
  leaseId                 String?
  leaseExpiresAt          DateTime?
  completedAt             DateTime?
  lastErrorCode           String?
  lastErrorMessage        String?   @db.Text
  integrationConnectionId String?
  zoteroLibraryId         String?
  documentId              String?
  assetId                 String?
  intakeId                String?
  ingestReceiptId         String?
  createdById             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration            IntegrationConnection?          @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  zoteroLibrary          ZoteroLibrary?                  @relation(fields: [organizationId, zoteroLibraryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document               Document?                       @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  asset                  Asset?                          @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  intake                 DocumentIntake?                 @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction)
  ingestReceipt          DocumentIngestReceipt?          @relation(fields: [organizationId, documentId, assetId, ingestReceiptId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy              User?                           @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  jobAttempts            JobAttempt[]
  validationAttestations DocumentValidationAttestation[]
  textExtractions        DocumentTextExtraction[]
  zoteroAttachmentImport ZoteroAttachmentImport?
  crawlerImport          CrawlerImport?
  ingressAttempts        DocumentIngressAttempt[]

  @@unique([organizationId, type, dedupeKey])
  @@unique([organizationId, id])
  @@unique([organizationId, documentId, assetId, id])
  @@unique([organizationId, documentId, assetId, intakeId, id], map: "Job_intake_target_binding_key")
  @@unique([organizationId, integrationConnectionId, zoteroLibraryId, documentId, assetId, intakeId, id], map: "Job_zotero_download_target_binding_key")
  @@index([status, runAfter, priority])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, status])
  @@index([integrationConnectionId])
  @@index([zoteroLibraryId])
  @@index([documentId])
  @@index([assetId])
  @@index([intakeId])
  @@index([ingestReceiptId])
  @@index([createdById])
}

model JobAttempt {
  id             String    @id @default(cuid())
  organizationId String
