model Asset {
  id                      String               @id @default(cuid())
  organizationId          String
  storageProvider         AssetStorageProvider
  bucket                  String?
  objectKey               String
  physicalLocator         String?              @unique
  status                  AssetStatus          @default(UPLOADING)
