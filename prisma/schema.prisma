  CLAIM
  METHOD
  RESULT
  LIMITATION
  QUOTE
  QUESTION
  NOTE
}

enum EvidenceStatus {
  CAPTURED
  NEEDS_VERIFICATION
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum EvidenceConfidence {
  HIGH
  MEDIUM
  LOW
  UNSPECIFIED
}

enum IntegrationProvider {
  ZOTERO
  OPENALEX
  CROSSREF
  PUBMED
  ARXIV
  SEMANTIC_SCHOLAR
  WEB_CRAWLER
  WEB_MCP
  OBJECT_STORAGE
  OTHER
}

enum IntegrationAuthType {
  OAUTH1
  OAUTH2
  API_KEY
  SERVICE_ACCOUNT
  NONE
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  DEGRADED
  REVOKED
  DISCONNECTED
}

enum ZoteroOAuthAttemptStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum ZoteroLibraryType {
  USER
  GROUP
}

enum ZoteroFileAccessStatus {
  AVAILABLE
  UNKNOWN
  UNAVAILABLE
}

enum ZoteroAttachmentIngestMode {
  DISABLED
  MANUAL
}

enum ZoteroAttachmentEligibility {
  DOWNLOADABLE
  INELIGIBLE
  MALFORMED
}

enum ZoteroAttachmentImportStatus {
  QUEUED
  DOWNLOADING
  QUARANTINED
  VALIDATING
  EXTRACTING
  READY
  ATTENTION
  FAILED
  CANCELLED
}

// First-mode crawler admission is intentionally closed. Broader grants or
// retention/robots modes require an explicit schema and policy migration.
enum CrawlerRightsGrant {
  INDEFINITE_RESEARCH_CUSTODY
}

enum CrawlerRobotsPolicy {
  RESPECT_RFC9309
}

enum CrawlerRetentionPolicy {
  INDEFINITE_UNTIL_USER_DELETION
}

enum CrawlerImportStatus {
  QUEUED
  FETCHING
  QUARANTINED
  VALIDATING
  EXTRACTING
  READY
  ATTENTION
  FAILED
  CANCELLED
}

// Byte custody is deliberately orthogonal to ingestion success/failure. A
// deletion request can therefore retire a READY paper without rewriting the
// immutable evidence of how that import completed.
enum CrawlerCustodyStatus {
  RETAINED
  DELETE_PENDING
  DELETED
}

// Machine-derived text is retired independently from the original PDF bytes.
// A supporting generation remains only when deleting it would destroy a
// user-authored grounded evidence chain.
enum CrawlerDerivedTextDisposition {
  NONE
  PURGED
  RETAINED_FOR_USER_EVIDENCE
}

enum ZoteroObjectType {
  ITEM
  COLLECTION
  SAVED_SEARCH
  FULLTEXT
  ATTACHMENT
}

enum SyncDirection {
  PULL
  PUSH
  BIDIRECTIONAL
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
  BACKING_OFF
}

enum JobType {
  IMPORT_RESOLVE
  METADATA_REFRESH
  DOCUMENT_DOWNLOAD
  DOCUMENT_VALIDATE
  VIRUS_SCAN
  TEXT_EXTRACTION
  ZOTERO_SYNC
  CRAWL
  WEB_MCP_IMPORT
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

// Every accepted byte source converges on the same immutable custody authority.
// Source-specific reservations and download attempts remain separate transports.
enum DocumentIngestSource {
  BROWSER_UPLOAD
  ZOTERO_ATTACHMENT
  CRAWLER
  WEB_MCP
}

enum DocumentIntakeStatus {
  RESERVED
  QUEUED
  RECEIVING
  QUARANTINED
  VALIDATING
  EXTRACTING
  READY
  ATTENTION
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

