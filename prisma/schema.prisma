// Source-neutral reservation and lifecycle authority. Every transport reserves
// tenant quota here before bytes are accepted, while transport-specific state
// remains in UploadSession, ZoteroAttachmentImport, or later crawler/WebMCP rows.
model DocumentIntake {
  id                String               @id @default(cuid())
  organizationId    String
  source            DocumentIngestSource
  status            DocumentIntakeStatus @default(RESERVED)
  documentId        String
  assetId           String
  inboxEntryId      String?
  importBatchId     String?
  createdById       String?
  reservedBytes     BigInt
  committedBytes    BigInt?
  policyRevision    Int                  @default(0)
  failureCode       String?              @db.VarChar(100)
  cancelRequestedAt DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  quotaReleasedAt   DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document               Document                 @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  asset                  Asset                    @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  inboxEntry             InboxEntry?              @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  importBatch            ImportBatch?             @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy              User?                    @relation("DocumentIntakeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  uploadSession          UploadSession?
  zoteroAttachmentImport ZoteroAttachmentImport?
  crawlerImport          CrawlerImport?
  receipt                DocumentIngestReceipt?
  attempts               DocumentIngressAttempt[]
  jobs                   Job[]

  @@unique([organizationId, id])
  @@unique([organizationId, documentId])
  @@unique([organizationId, assetId])
  @@unique([organizationId, inboxEntryId])
  @@unique([organizationId, documentId, assetId, id], map: "DocumentIntake_target_binding_key")
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdById, status])
}

// Durable source-neutral receive attempt. Provider workers can reconcile or
// clean an exact immutable quarantine object after a crash without trusting a
// mutable job payload or signed provider URL.
model DocumentIngressAttempt {
  id                         String                       @id
  organizationId             String
  intakeId                   String
  documentId                 String
  assetId                    String
  jobId                      String
  jobAttemptId               String                       @unique
  attemptNumber              Int
  storageKey                 String                       @unique
  storageVersion             String                       @db.VarChar(128)
  storageAuthorityGeneration String?                      @db.Char(64)
  status                     DocumentIngressAttemptStatus @default(RECEIVING)
  maximumSizeBytes           BigInt
  expectedSizeBytes          BigInt?
  receivedSizeBytes          BigInt?
  providerMd5                String?                      @db.Char(32)
  computedMd5                String?                      @db.Char(32)
  sha256                     String?                      @db.Char(64)
  leaseId                    String                       @db.VarChar(200)
  leaseExpiresAt             DateTime
  storedAt                   DateTime?
  completedAt                DateTime?
  failureCode                String?                      @db.VarChar(100)
  cleanupCompletedAt         DateTime?
  cleanupAttemptCount        Int                          @default(0)
  cleanupAfter               DateTime?
  cleanupFailureCode         String?                      @db.VarChar(100)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intake        DocumentIntake         @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngressAttempt_intake_target_fkey")
  document      Document               @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  asset         Asset                  @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  job           Job                    @relation(fields: [organizationId, documentId, assetId, intakeId, jobId], references: [organizationId, documentId, assetId, intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngressAttempt_job_intake_target_fkey")
  jobAttempt    JobAttempt             @relation(fields: [organizationId, jobId, jobAttemptId], references: [organizationId, jobId, id], onDelete: Restrict, onUpdate: NoAction)
  ingestReceipt DocumentIngestReceipt?

  @@unique([organizationId, id])
  @@unique([intakeId, attemptNumber])
  @@unique([organizationId, jobId, jobAttemptId], map: "DocumentIngressAttempt_job_attempt_binding_key")
  @@unique([organizationId, intakeId, id])
  @@unique([organizationId, documentId, assetId, intakeId, id], map: "DocumentIngressAttempt_target_binding_key")
  @@index([status, leaseExpiresAt])
  @@index([status, cleanupAfter])
  @@index([organizationId, intakeId])
  @@index([organizationId, assetId])
  @@index([organizationId, jobId])
}

// A browser upload is a durable, single-writer reservation. The display name
// is never used as a path; physical storage is referenced only through Asset.
// A successful first-stage upload remains quarantined until an isolated worker
// performs malware scanning and document validation in a later lifecycle step.
model UploadSession {
  id                String              @id @default(cuid())
  organizationId    String
  createdById       String?
  intakeId          String
  assetId           String
  documentId        String
  inboxEntryId      String
  clientOperationId String
  requestHash       String              @db.Char(64)
  status            UploadSessionStatus @default(ISSUED)
  originalFileName  String
  declaredMimeType  String
  expectedSizeBytes BigInt
  receivedSizeBytes BigInt?
  sha256            String?             @db.Char(64)
  expiresAt         DateTime
  claimedAt         DateTime?
  claimExpiresAt    DateTime?
  claimId           String?
  storedAt          DateTime?
  rejectedAt        DateTime?
  failureCode       String?
  attemptCount      Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("UploadSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  intake        DocumentIntake         @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction)
  asset         Asset                  @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document      Document               @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  inboxEntry    InboxEntry             @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  attempts      UploadAttempt[]
  ingestReceipt DocumentIngestReceipt?

  @@unique([organizationId, clientOperationId])
  @@unique([organizationId, intakeId])
  @@unique([organizationId, documentId, assetId, intakeId], map: "UploadSession_intake_binding_key")
  @@unique([organizationId, id])
  @@unique([organizationId, id, assetId], map: "UploadSession_asset_binding_key")
  @@unique([organizationId, documentId])
  @@unique([organizationId, inboxEntryId])
  @@unique([organizationId, assetId])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, createdById, status])
  @@index([assetId])
}

// Every receive lease has a durable, immutable object identity before bytes
// leave the request process. This lets reconciliation clean or adopt a crashed
// attempt without relying on an overwritten UploadSession.claimId.
model UploadAttempt {
  id                  String              @id
  organizationId      String
  uploadSessionId     String
  assetId             String
  attemptNumber       Int
  storageKey          String              @unique
  status              UploadAttemptStatus @default(RECEIVING)
  expectedSizeBytes   BigInt
  receivedSizeBytes   BigInt?
  sha256              String?             @db.Char(64)
  leaseExpiresAt      DateTime
  storedAt            DateTime?
  completedAt         DateTime?
  failureCode         String?
  cleanupCompletedAt  DateTime?
  cleanupAttemptCount Int                 @default(0)
  cleanupAfter        DateTime?
  cleanupFailureCode  String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadSession UploadSession          @relation(fields: [organizationId, uploadSessionId, assetId], references: [organizationId, id, assetId], onDelete: Restrict, onUpdate: NoAction, map: "UploadAttempt_session_asset_fkey")
  asset         Asset                  @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  ingestReceipt DocumentIngestReceipt?

  @@unique([organizationId, id])
  @@unique([organizationId, uploadSessionId, assetId, id], map: "UploadAttempt_transport_binding_key")
  @@unique([uploadSessionId, attemptNumber])
  @@index([status, leaseExpiresAt])
  @@index([status, cleanupAfter])
  @@index([organizationId, uploadSessionId])
  @@index([organizationId, assetId])
}

// Immutable proof that one exact byte stream was durably committed to private
// quarantine. Browser upload, Zotero, crawler, and WebMCP transports must create
// this same authority before validation can claim their Document/Asset pair.
model DocumentIngestReceipt {
  id                         String               @id @default(cuid())
  organizationId             String
  source                     DocumentIngestSource
  sourceFingerprint          String               @db.VarChar(512)
  intakeId                   String
  assetId                    String
  documentId                 String
  inboxEntryId               String?
  importBatchId              String?
  uploadSessionId            String?
  uploadAttemptId            String?
  ingressAttemptId           String?
  integrationConnectionId    String?
  zoteroLibraryId            String?
  zoteroObjectId             String?
  zoteroAttachmentImportId   String?
  crawlerImportId            String?
  requestedById              String?
  sourceVersion              String?              @db.VarChar(128)
  sourceEtag                 String?              @db.VarChar(255)
  sourceChecksumAlgorithm    String?              @db.VarChar(32)
  sourceChecksum             String?              @db.VarChar(128)
  declaredMimeType           String               @db.VarChar(255)
  receivedSizeBytes          BigInt
  sha256                     String               @db.Char(64)
  storageVersion             String               @db.VarChar(128)
  storageAuthorityGeneration String?              @db.Char(64)
  storedAt                   DateTime
  metadata                   Json?
  legacyTransportAttestation Boolean              @default(false)
  createdAt                  DateTime             @default(now())

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intake                 DocumentIntake                  @relation(fields: [organizationId, documentId, assetId, intakeId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_intake_target_fkey")
  asset                  Asset                           @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document               Document                        @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  inboxEntry             InboxEntry?                     @relation(fields: [organizationId, inboxEntryId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  importBatch            ImportBatch?                    @relation(fields: [organizationId, importBatchId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  uploadSession          UploadSession?                  @relation(fields: [organizationId, uploadSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  uploadAttempt          UploadAttempt?                  @relation(fields: [organizationId, uploadSessionId, assetId, uploadAttemptId], references: [organizationId, uploadSessionId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_upload_attempt_fkey")
  ingressAttempt         DocumentIngressAttempt?         @relation(fields: [organizationId, documentId, assetId, intakeId, ingressAttemptId], references: [organizationId, documentId, assetId, intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_ingress_attempt_fkey")
  integration            IntegrationConnection?          @relation(fields: [organizationId, integrationConnectionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  zoteroLibrary          ZoteroLibrary?                  @relation(fields: [organizationId, integrationConnectionId, zoteroLibraryId], references: [organizationId, integrationConnectionId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_zotero_library_connection_fkey")
  zoteroObject           ZoteroObject?                   @relation(fields: [organizationId, zoteroLibraryId, zoteroObjectId], references: [organizationId, zoteroLibraryId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_zotero_object_library_fkey")
  zoteroAttachmentImport ZoteroAttachmentImport?         @relation(fields: [organizationId, integrationConnectionId, zoteroLibraryId, zoteroObjectId, documentId, assetId, intakeId, zoteroAttachmentImportId], references: [organizationId, integrationConnectionId, zoteroLibraryId, zoteroObjectId, documentId, assetId, intakeId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_zotero_import_target_fkey")
  crawlerImport          CrawlerImport?                  @relation(fields: [organizationId, documentId, assetId, intakeId, importBatchId, crawlerImportId], references: [organizationId, documentId, assetId, intakeId, importBatchId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentIngestReceipt_crawler_import_target_fkey")
  requestedBy            User?                           @relation("DocumentIngestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  jobs                   Job[]
  validationAttestations DocumentValidationAttestation[]

  @@unique([organizationId, source, sourceFingerprint])
  @@unique([organizationId, id])
  @@unique([organizationId, intakeId])
  @@unique([organizationId, documentId, assetId, intakeId], map: "DocumentIngestReceipt_intake_binding_key")
  @@unique([organizationId, assetId])
  @@unique([organizationId, documentId])
  @@unique([organizationId, documentId, assetId, id], map: "DocumentIngestReceipt_target_binding_key")
  @@unique([organizationId, inboxEntryId])
  @@unique([organizationId, uploadSessionId])
  @@unique([organizationId, uploadSessionId, assetId, uploadAttemptId], map: "DocumentIngestReceipt_upload_attempt_binding_key")
  @@unique([organizationId, ingressAttemptId])
  @@unique([organizationId, documentId, assetId, intakeId, ingressAttemptId], map: "DocumentIngestReceipt_ingress_attempt_binding_key")
  @@unique([organizationId, integrationConnectionId, zoteroLibraryId, zoteroObjectId, documentId, assetId, intakeId, zoteroAttachmentImportId], map: "DocumentIngestReceipt_zotero_import_binding_key")
  @@unique([organizationId, crawlerImportId])
  @@unique([organizationId, documentId, assetId, intakeId, importBatchId, crawlerImportId], map: "DocumentIngestReceipt_crawler_import_binding_key")
  @@index([organizationId, source, storedAt])
  @@index([integrationConnectionId])
  @@index([zoteroLibraryId])
  @@index([zoteroObjectId])
  @@index([requestedById])
}

// Immutable, bounded evidence returned by the isolated validation service.
// Raw parser/scanner output and filesystem paths never belong in this table.
model DocumentValidationAttestation {
  id                   String               @id @default(cuid())
  organizationId       String
  jobId                String
  jobAttemptId         String               @unique
  assetId              String
  documentId           String
  ingestReceiptId      String
  inputSha256          String               @db.Char(64)
  inputSizeBytes       BigInt
  storageVersion       String
  policyVersion        String
  toolchainDigest      String               @db.Char(64)
  verdict              ValidationVerdict
  rejectionCode        String?
  malwareVerdict       MalwareVerdict
  malwareEngine        String
  malwareEngineVersion String
  signatureVersion     String
  signaturePublishedAt DateTime
  scannedAt            DateTime
  pdfStructuralVerdict PdfStructuralVerdict
  pdfEngine            String
  pdfEngineVersion     String
  pdfVersion           String
  pageCount            Int?
  objectCount          Int?
  revisionCount        Int?
  checkedAt            DateTime
  result               Json?
  createdAt            DateTime             @default(now())

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             Job                      @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  jobAttempt      JobAttempt               @relation(fields: [organizationId, jobAttemptId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  asset           Asset                    @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  document        Document                 @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  ingestReceipt   DocumentIngestReceipt    @relation(fields: [organizationId, documentId, assetId, ingestReceiptId], references: [organizationId, documentId, assetId, id], onDelete: Restrict, onUpdate: NoAction, map: "DocumentValidationAttestation_ingest_target_fkey")
  textExtractions DocumentTextExtraction[]

  @@unique([organizationId, id])
  @@unique([organizationId, jobAttemptId])
  @@unique([organizationId, documentId, assetId, id])
  @@unique([assetId, inputSha256, storageVersion, policyVersion, toolchainDigest], map: "DocumentValidationAttestation_asset_identity_key")
  @@index([organizationId, verdict, createdAt], map: "DocumentValidationAttestation_organizationId_verdict_createdAt_")
  @@index([jobId])
  @@index([assetId])
  @@index([documentId])
  @@index([ingestReceiptId])
}

model DocumentAsset {
  id             String            @id @default(cuid())
  organizationId String
  documentId     String
  assetId        String
  role           DocumentAssetRole @default(ORIGINAL)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  asset        Asset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([documentId, assetId, role])
  @@index([organizationId, documentId])
  @@index([organizationId, assetId])
}

// Immutable, bounded provenance for one successful text-extraction attempt.
// Reader eligibility is derived from this record and its validation/input
// bindings; mutable Document or Asset metadata is never authoritative.
model DocumentTextExtraction {
  id                      String                @id @default(cuid())
  organizationId          String
  jobId                   String
  jobAttemptId            String                @unique
  validationAttestationId String
  assetId                 String
  documentId              String
  inputSha256             String                @db.Char(64)
  inputSizeBytes          BigInt
  storageVersion          String                @db.VarChar(128)
  extractionPolicyVersion String                @db.VarChar(128)
  toolchainDigest         String                @db.Char(64)
  verdict                 TextExtractionVerdict
  engine                  String                @db.VarChar(64)
  engineVersion           String                @db.VarChar(128)
  pageCount               Int
  chunkCount              Int
  textBytes               Int
  extractedAt             DateTime
  completedAt             DateTime
  durationMs              Int
  totalDurationMs         Int
  checkedAt               DateTime
  result                  Json?
  createdAt               DateTime              @default(now())

  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                   Job                            @relation(fields: [organizationId, documentId, assetId, jobId], references: [organizationId, documentId, assetId, id], onDelete: Cascade, onUpdate: NoAction)
  jobAttempt            JobAttempt                     @relation(fields: [organizationId, jobId, jobAttemptId], references: [organizationId, jobId, id], onDelete: Cascade, onUpdate: NoAction)
  validationAttestation DocumentValidationAttestation  @relation(fields: [organizationId, documentId, assetId, validationAttestationId], references: [organizationId, documentId, assetId, id], onDelete: Cascade, onUpdate: NoAction)
  asset                 Asset                          @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  document              Document                       @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  chunks                DocumentTextChunk[]
  manifestAdmission     DocumentTextManifestAdmission?

  @@unique([organizationId, id])
  @@unique([organizationId, documentId, id])
  @@unique([organizationId, jobAttemptId])
  @@unique([organizationId, jobId, jobAttemptId])
  @@unique([organizationId, documentId, assetId, inputSha256, storageVersion, extractionPolicyVersion, toolchainDigest], map: "DocumentTextExtraction_generation_key")
  @@index([organizationId, documentId, extractionPolicyVersion, createdAt(sort: Desc)], map: "DocumentTextExtraction_current_generation_idx")
  @@index([organizationId, assetId, createdAt])
  @@index([jobId])
  @@index([validationAttestationId])
}

// Database-admitted proof that a complete immutable extraction manifest passed
// every ordered, canonical-text, locator, and content-hash invariant. Reader
// trusts this compact seal before issuing bounded chunk-range queries.
model DocumentTextManifestAdmission {
  extractionId   String                @id
  organizationId String
  documentId     String
  schemaVersion  Int                   @db.SmallInt
  verdict        TextExtractionVerdict
  pageCount      Int
  chunkCount     Int
  textBytes      Int
  manifestSha256 String                @db.Char(64)
  admittedAt     DateTime              @default(now())

  extraction          DocumentTextExtraction @relation(fields: [organizationId, documentId, extractionId], references: [organizationId, documentId, id], onDelete: Cascade, onUpdate: NoAction, map: "DocumentTextManifestAdmission_extraction_fkey")
  evidenceTextAnchors EvidenceTextAnchor[]

  @@unique([organizationId, documentId, extractionId], map: "DocumentTextManifestAdmission_binding_key")
  @@unique([organizationId, documentId, extractionId, schemaVersion, manifestSha256], map: "DocumentTextManifestAdmission_digest_binding_key")
  @@index([organizationId, documentId], map: "DocumentTextManifestAdmission_document_idx")
}

model DocumentTextChunk {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  extractionId   String?
  sequence       Int
  pageStart      Int?
  pageEnd        Int?
  sectionId      String?
  sectionTitle   String?
  paragraphId    String?
  charStart      Int?
  charEnd        Int?
  text           String   @db.Text
  contentHash    String
  locator        Json?
  createdAt      DateTime @default(now())

  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document                Document                @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  extraction              DocumentTextExtraction? @relation(fields: [organizationId, documentId, extractionId], references: [organizationId, documentId, id], onDelete: Cascade, onUpdate: NoAction)
  evidenceNotes           EvidenceNote[]
  evidenceAnchorsStarting EvidenceTextAnchor[]    @relation("EvidenceTextAnchorStartChunk")
  evidenceAnchorsEnding   EvidenceTextAnchor[]    @relation("EvidenceTextAnchorEndChunk")

  @@unique([extractionId, sequence])
  @@unique([organizationId, id])
  @@unique([organizationId, documentId, id])
  @@unique([organizationId, documentId, extractionId, id, sequence, contentHash], map: "DocumentTextChunk_evidence_anchor_binding_key")
  @@index([organizationId, documentId])
  @@index([organizationId, extractionId, sequence])
  @@index([contentHash])
}
