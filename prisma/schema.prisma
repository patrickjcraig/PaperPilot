  job                   Job                            @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  validationAttestation DocumentValidationAttestation?
  textExtraction        DocumentTextExtraction?
  ingressAttempt        DocumentIngressAttempt?

  @@unique([jobId, attemptNumber])
  @@unique([jobId, leaseId])
  @@unique([organizationId, id])
  @@unique([organizationId, jobId, id])
  @@index([organizationId, status])
  @@index([workerId])
}

// Append-only security and collaboration history. IP addresses are represented
// only by a keyed hash so the audit log does not retain raw network identifiers.
model AuditEvent {
  id               String   @id @default(cuid())
  organizationId   String
  actorUserId      String?
  actorPrincipalId String?  @db.Uuid
  action           String
  entityType       String
  entityId         String?
  requestId        String?
  ipAddressHash    String?
  userAgent        String?
  metadata         Json?
