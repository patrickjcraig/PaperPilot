  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?                   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorPrincipal RetainedAuditPrincipal? @relation("AuditRetainedActor", fields: [organizationId, actorPrincipalId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "AuditEvent_retained_actor_fkey")

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([actorPrincipalId])
  @@index([requestId])
}

model Document {
